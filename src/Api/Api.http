@host = http://localhost:5205

# Personal Finance Manager - API requests
# Pokreni API: dotnet run --project src/Api
# Id-eve u zahtjevima prilagodi svojoj bazi.
# Tip transakcije: 0 = Income, 1 = Expense


################################################################
# CATEGORIES
################################################################

### Get all categories (expect 200)
GET {{host}}/api/categories

### Get one category (expect 200)
GET {{host}}/api/categories/1

### Get category that does not exist (expect 404)
GET {{host}}/api/categories/999

### Create a category (expect 201)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Entertainment" }

### Validation: empty name (expect 400)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "" }

### Update a category (expect 204)
PUT {{host}}/api/categories/1
Content-Type: application/json

{ "name": "Groceries" }

### Update category that does not exist (expect 404)
PUT {{host}}/api/categories/999
Content-Type: application/json

{ "name": "Nothing" }

### Delete category that has transactions (expect 409)
DELETE {{host}}/api/categories/1

### Delete category that does not exist (expect 404)
DELETE {{host}}/api/categories/999


################################################################
# TRANSACTIONS - READ
################################################################

### Get all transactions (expect 200)
GET {{host}}/api/transactions

### Get one transaction (expect 200, with category)
GET {{host}}/api/transactions/1

### Get transaction that does not exist (expect 404)
GET {{host}}/api/transactions/999


################################################################
# TRANSACTIONS - FILTERS
################################################################

### Filter by category
GET {{host}}/api/transactions?categoryId=1

### Filter by category with no transactions (expect empty list)
GET {{host}}/api/transactions?categoryId=99

### Filter by date range
GET {{host}}/api/transactions?from=2026-10-01&to=2026-10-31

### Filter by category and date range
GET {{host}}/api/transactions?categoryId=1&from=2026-10-01&to=2026-10-31

### Date range in the past (expect empty list)
GET {{host}}/api/transactions?from=2020-01-01&to=2020-12-31


################################################################
# TRANSACTIONS - SUMMARY
################################################################

### Summary for all transactions
GET {{host}}/api/transactions/summary

### Summary for a date range
GET {{host}}/api/transactions/summary?from=2026-10-01&to=2026-10-31

### Summary for a period with no transactions (expect all zeros)
GET {{host}}/api/transactions/summary?from=2020-01-01&to=2020-12-31


################################################################
# TRANSACTIONS - CREATE, UPDATE, DELETE
################################################################

### Create an expense (expect 201)
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": 20.00,
  "description": "Coffee",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 1
}

### Validation: negative amount (expect 400)
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": -5,
  "description": "Invalid amount",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 1
}

### Validation: empty description (expect 400)
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": 10,
  "description": "",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 1
}

### Category that does not exist (expect 400)
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": 10,
  "description": "Unknown category",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 99
}

### Update a transaction (expect 204)
PUT {{host}}/api/transactions/1
Content-Type: application/json

{
  "amount": 50.00,
  "description": "Updated description",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 1
}

### Update transaction that does not exist (expect 404)
PUT {{host}}/api/transactions/999
Content-Type: application/json

{
  "amount": 10,
  "description": "Does not exist",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 1
}

### Delete transaction that does not exist (expect 404)
DELETE {{host}}/api/transactions/999