@host = http://localhost:5205

### Create Groceries (expect 201)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Groceries" }

### Create Electronics (expect 201)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Electronics" }

### Create Bills (expect 201)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Bills" }

### Create Earnings (expect 201)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "Earnings" }

### Get all (expect 200, four categories)
GET {{host}}/api/categories

### Get one (expect 200)
GET {{host}}/api/categories/1

### Get one that does not exist (expect 404)
GET {{host}}/api/categories/999

### Validation: empty name (expect 400)
POST {{host}}/api/categories
Content-Type: application/json

{ "name": "" }

### Validation: name missing (expect 400)
POST {{host}}/api/categories
Content-Type: application/json

{ }

### Update (expect 204)
PUT {{host}}/api/categories/2
Content-Type: application/json

{ "name": "Tech" }

### Check the update (expect Tech)
GET {{host}}/api/categories/2

### Update that does not exist (expect 404)
PUT {{host}}/api/categories/999
Content-Type: application/json

{ "name": "Nothing" }

### Delete (expect 204)
DELETE {{host}}/api/categories/4

### Check the deletion (expect 404)
GET {{host}}/api/categories/4

### Delete that does not exist (expect 404)
DELETE {{host}}/api/categories/999





### Summary for all transactions
GET {{host}}/api/transactions/summary

### Summary for a date range
GET {{host}}/api/transactions/summary?from=2026-10-01&to=2026-10-31

### Summary for a period with no transactions (expect all zeros)
GET {{host}}/api/transactions/summary?from=2020-01-01&to=2020-12-31



### Create income
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": 1200.00,
  "description": "Freelance project",
  "date": "2026-10-03T12:00:00",
  "type": 0,
  "categoryId": 5
}

### Create expense 1
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": 20.00,
  "description": "Coffee",
  "date": "2026-10-03T10:00:00",
  "type": 1,
  "categoryId": 1
}

### Create expense 2
POST {{host}}/api/transactions
Content-Type: application/json

{
  "amount": 80.50,
  "description": "Headphones",
  "date": "2026-10-04T15:00:00",
  "type": 1,
  "categoryId": 3
}

### Delete category that has transactions (now 500, later 409)
DELETE {{host}}/api/categories/1

### Delete category without transactions (expect 204)
DELETE {{host}}/api/categories/2

### Delete duplicate 6
DELETE {{host}}/api/categories/6

### Delete duplicate 7
DELETE {{host}}/api/categories/7

